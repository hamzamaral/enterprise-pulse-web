# Leave empty in development: Vite proxies /api and /socket.io to the API.
# Set to the API origin (e.g. https://api.example.com) when hosting the web app separately.
VITE_API_URL=
VITE_WS_URL=

# Dev proxy target (vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:3000

# Used by `pnpm api:generate`
OPENAPI_URL=http://localhost:3000/docs-json
